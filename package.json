{
  "name": "homepage",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "sync": "svelte-kit sync",
    "sequoia:build": "sequoia build",
    "sequoia:publish": "sequoia publish && sequoia inject"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.4",
    "@types/d3": "^7.4.3",
    "@types/lodash": "^4.17.16",
    "@types/lodash-es": "^4.17.12",
    "@types/masonry-layout": "^4.2.8",
    "@types/node": "^22",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "mdsvex": "^0.12.6",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "sass-embedded": "^1.85.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.12",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/svelte-fontawesome": "^0.2.4",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "lodash-es": "^4.17.21",
    "sequoia": "^0.0.1",
    "sequoia-cli": "github:cbroome/sequoia",
    "svelte-fontawesome": "^0.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "esbuild@0.25.12": true
  },
  "overrides": {}
}
