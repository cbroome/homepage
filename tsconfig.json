{
	"extends": "$app/tsconfig",
    "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "types": ["$app/types", "node", "vite/client", "@vitest/expect", "vitest/globals"]
    },
    "include": [
        "types/*.d.ts",
        "src/**/*.d.ts",
        "src/**/*.ts",
        "src/**/*.js",
        "src/**/*.svelte",
        "vite.config.ts",
        "vitest-setup-client.ts"
    ]
}